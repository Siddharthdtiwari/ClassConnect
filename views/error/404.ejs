<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>404 - Page Not Found | Tuition Hub</title>
  <link rel="icon" href="/favicon.ico" type="image/x-icon">
  <link rel="apple-touch-icon" href="/images/logo.png">
  <link href="/css/style.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@300;400;700;900&family=Space+Mono:ital,wght@0,400;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
</head>
<body class="bg-theme-bg text-theme-fg font-sans min-h-screen flex items-center justify-center relative overflow-hidden">
  
  <%- include('../partials/background') %>

  <div class="relative z-10 text-center px-4 max-w-lg mx-auto">
    <!-- Animated SVG Error Graphic -->
    <div class="mb-8 flex justify-center">
      <div class="relative w-40 h-40 flex items-center justify-center bg-theme-bgc rounded-full shadow-2xl border-4 border-theme-b">
        <div class="absolute inset-0 rounded-full border-4 border-theme-p border-dashed animate-spin-slow opacity-30"></div>
        <svg class="w-20 h-20 text-theme-pt" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
      </div>
    </div>

    <!-- Error Text -->
    <h1 class="text-6xl md:text-8xl font-unbounded font-black text-theme-pt mb-4 drop-shadow-md">
      404
    </h1>
    <h2 class="text-2xl md:text-3xl font-unbounded font-bold text-theme-fg mb-4">
      Page Not Found
    </h2>
    <p class="text-theme-fd font-mono text-sm leading-relaxed mb-10 max-w-md mx-auto">
      Oops! The page you are looking for might have been removed, had its name changed, or is temporarily unavailable.
    </p>

    <!-- Action Buttons -->
    <div class="flex flex-col sm:flex-row justify-center gap-4">
      <button onclick="window.history.back()" class="bg-theme-bgch hover:bg-theme-b text-theme-pt font-unbounded font-bold py-3 px-8 rounded-xl border border-theme-bd transition-all shadow-sm">
        Go Back
      </button>
      <a href="/" class="bg-theme-p hover:bg-theme-pt text-white font-unbounded font-bold py-3 px-8 rounded-xl shadow-lg shadow-theme-pg/30 transition-all flex items-center justify-center gap-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
        Go Home
      </a>
    </div>
  </div>

</body>
</html>
