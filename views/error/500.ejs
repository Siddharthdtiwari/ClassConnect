<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>500 - Server Error | Tuition Hub</title>
  <link rel="icon" href="/favicon.ico" type="image/x-icon">
  <link rel="apple-touch-icon" href="/images/logo.png">
  <link href="/css/style.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@300;400;700;900&family=Space+Mono:ital,wght@0,400;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
</head>
<body class="bg-theme-bg text-theme-fg font-sans min-h-screen flex items-center justify-center relative overflow-hidden">
  
  <%- include('../partials/background') %>

  <div class="relative z-10 text-center px-4 max-w-lg mx-auto">
    <!-- Animated SVG Error Graphic -->
    <div class="mb-8 flex justify-center">
      <div class="relative w-40 h-40 flex items-center justify-center bg-theme-bgc rounded-full shadow-2xl border-4 border-red-500/20">
        <div class="absolute inset-0 rounded-full border-4 border-red-500/40 border-dashed animate-spin-slow opacity-50"></div>
        <svg class="w-20 h-20 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
      </div>
    </div>

    <!-- Error Text -->
    <h1 class="text-6xl md:text-8xl font-unbounded font-black text-red-500 mb-4 drop-shadow-md">
      500
    </h1>
    <h2 class="text-2xl md:text-3xl font-unbounded font-bold text-theme-fg mb-4">
      Internal Server Error
    </h2>
    <p class="text-theme-fd font-mono text-sm leading-relaxed mb-6 max-w-md mx-auto">
      Yikes! Something went wrong on our servers. Our technical team has been notified and we are looking into it.
    </p>

    <!-- Error Details (If in Dev Mode) -->
    <% if (typeof error !== 'undefined' && typeof process !== 'undefined' && process.env.NODE_ENV !== 'production') { %>
      <div class="bg-theme-bgc border border-theme-bd rounded-lg p-4 mb-8 text-left max-h-48 overflow-y-auto">
        <p class="font-mono text-xs text-red-400 font-bold mb-2">Error Details (Development Only):</p>
        <pre class="font-mono text-[10px] text-theme-fg whitespace-pre-wrap"><%= error.message || error %></pre>
      </div>
    <% } else { %>
      <div class="mb-10"></div>
    <% } %>

    <!-- Action Buttons -->
    <div class="flex flex-col sm:flex-row justify-center gap-4 relative">
      <button onclick="window.location.reload()" class="bg-theme-bgch hover:bg-theme-b text-theme-pt font-unbounded font-bold py-3 px-8 rounded-xl border border-theme-bd transition-all shadow-sm flex items-center justify-center gap-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
        Try Again
      </button>
      <a href="/" class="bg-theme-p hover:bg-theme-pt text-white font-unbounded font-bold py-3 px-8 rounded-xl shadow-lg shadow-theme-pg/30 transition-all flex items-center justify-center gap-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
        Go Home
      </a>
      <button onclick="reportIssue(this)" class="bg-theme-bgc hover:bg-red-500 hover:text-white text-red-500 font-unbounded font-bold py-3 px-8 rounded-xl border border-red-500/30 transition-all flex items-center justify-center gap-2 mt-4 sm:mt-0 sm:absolute sm:top-16">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
        Report Issue
      </button>
    </div>
  </div>

  <script>
    async function reportIssue(btn) {
      if (btn.disabled) return;
      
      const originalText = btn.innerHTML;
      btn.innerHTML = "Reporting...";
      btn.disabled = true;
      btn.classList.add('opacity-50', 'cursor-not-allowed');

      try {
        const response = await fetch('/api/report-issue', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            url: window.location.href,
            time: new Date().toISOString()
          })
        });
        
        const data = await response.json();
        
        if (response.ok && data.success) {
          btn.innerHTML = "Issue Reported ✓";
          btn.classList.remove('text-red-500', 'hover:bg-red-500', 'border-red-500/30');
          btn.classList.add('text-green-500', 'border-green-500/30');
        } else {
          btn.innerHTML = data.message || "Failed to Report";
          setTimeout(() => {
            btn.innerHTML = originalText;
            btn.disabled = false;
            btn.classList.remove('opacity-50', 'cursor-not-allowed');
          }, 3000);
        }
      } catch (err) {
        btn.innerHTML = "Failed to Report";
        setTimeout(() => {
          btn.innerHTML = originalText;
          btn.disabled = false;
          btn.classList.remove('opacity-50', 'cursor-not-allowed');
        }, 3000);
      }
    }
  </script>

</body>
</html>
