<!DOCTYPE html>
<html lang="en" data-theme="light">
<%- include('../partials/background') %>
<head>
  <link rel="icon" href="/favicon.ico" type="image/x-icon">
  <link rel="apple-touch-icon" href="/images/logo.png">
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Student Portal | Tuition Hub</title>
  <style>
    @keyframes shake {
      0%, 100% { transform: translateX(0); }
      25%, 75% { transform: translateX(-5px); }
      50% { transform: translateX(5px); }
    }
    .animate-shake {
      animation: shake 0.3s ease-in-out;
    }
  </style>
</head>

<body class="text-theme-fg wrap min-h-screen flex flex-col items-center justify-center relative overflow-hidden">
  
  <a href="/" class="absolute top-6 left-6 inline-flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-theme-fd hover:text-theme-pt transition-colors z-20 bg-theme-bgc border border-theme-b px-4 py-2 rounded-full backdrop-blur-md">
    <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
    Home
  </a>

  <div class="content-container w-full max-w-md px-4 relative z-10">
    <div class="glass-card p-8 sm:p-12 flex flex-col items-center relative overflow-hidden text-center">
      <div class="absolute top-0 left-0 w-full h-2 bg-gradient-to-r from-theme-p to-theme-lt"></div>
      
      <img src="/images/logo.png" alt="Tuition Hub Logo" class="h-16 w-auto mb-6 drop-shadow-md" />
      
      <h3 class="text-2xl font-unbounded font-extrabold text-theme-fg mb-2 leading-tight">
        Student <span class="text-theme-pt">Portal</span>
      </h3>
      <p class="text-sm font-mono text-theme-fd uppercase tracking-wide mb-8">
        Sign in to your learning dashboard
      </p>

      <form action="/student/login" method="POST" class="w-full flex flex-col gap-4">
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>">
        
        <div class="flex flex-col gap-1 text-left">
          <label class="font-mono text-xs text-theme-fdd uppercase tracking-widest">ID Number</label>
          <input type="text" id="studentId" name="studentId" placeholder="e.g. STU12345" required 
            class="bg-theme-bgc border border-theme-b rounded-lg px-4 py-3 text-sm text-theme-fg outline-none transition-colors focus:border-theme-p focus:bg-theme-bgch placeholder-theme-fdd" />
        </div>
        
        <div class="flex flex-col gap-1 text-left mb-2">
          <label class="font-mono text-xs text-theme-fdd uppercase tracking-widest">Password</label>
          <div class="relative w-full">
            <input type="password" id="student-password" name="password" placeholder="••••••••" required 
              class="w-full bg-theme-bgc border border-theme-b rounded-lg px-4 py-3 text-sm text-theme-fg outline-none transition-colors focus:border-theme-p focus:bg-theme-bgch placeholder-theme-fdd pr-12" />
            <button type="button" onclick="const p = document.getElementById('student-password'); p.type = p.type === 'password' ? 'text' : 'password';" class="absolute right-3 top-1/2 -translate-y-1/2 text-theme-fdd hover:text-theme-pt transition-colors focus:outline-none">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
            </button>
          </div>
        </div>
        
        <div class="flex items-center gap-2 mb-2 text-left">
          <input type="checkbox" id="rememberMe" name="rememberMe" class="w-4 h-4 text-theme-p bg-theme-bgc border-theme-b rounded focus:ring-theme-p focus:ring-2 cursor-pointer">
          <label for="rememberMe" class="font-mono text-xs text-theme-fdd tracking-wide cursor-pointer">Stay logged in</label>
        </div>
        
        <button class="btn-primary w-full py-4 text-sm mt-2" type="submit">Access Dashboard</button>
      </form>

      <% if (typeof error !=='undefined' ) { %>
      <div class="mt-6 bg-red-500/10 border border-red-500/30 text-red-500 text-xs font-mono p-3 rounded-lg w-full animate-shake">
        <%= error %>
      </div>
      <% } %>
    </div>
  </div>

  <script>
    const loginForm = document.querySelector('form');

    if (loginForm) {
      loginForm.addEventListener('submit', function(e) {
        const btn = this.querySelector('button[type="submit"]');
        btn.disabled = true;
        btn.innerHTML = "Authenticating...";
        btn.style.opacity = "0.7";
        btn.style.cursor = "not-allowed";
      });
    }
  </script>
</body>

</html>