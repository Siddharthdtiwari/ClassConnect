<!DOCTYPE html>
<html lang="en" data-theme="light">
<%- include('../partials/background') %>
<head>
  <link rel="icon" href="/favicon.ico" type="image/x-icon">
  <link rel="apple-touch-icon" href="/images/logo.png">
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Syllabus Tracker | Tuition Hub</title>
  <script src="/js/subjects.js"></script>
  <style>
    .premium-banner {
      background: linear-gradient(135deg, var(--p) 0%, var(--pm) 100%);
      box-shadow: 0 10px 30px var(--pg);
    }
    .stat-card {
      background: var(--bgc);
      backdrop-filter: blur(16px);
      border: 1px solid var(--bd);
      border-radius: 18px;
      padding: 24px;
    }
    .chapter-pill {
      width: 48px;
      height: 48px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Space Mono', monospace;
      font-weight: bold;
      font-size: 14px;
      border: 2px solid transparent;
    }
    .status-incomplete {
      background-color: var(--bg2);
      color: var(--fdd);
      border-color: var(--bd);
    }
    .status-completed {
      background-color: #10B981;
      color: white;
      box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
      border-color: #059669;
    }
    .status-na {
      background-color: #374151;
      color: #9CA3AF;
      text-decoration: line-through;
      opacity: 0.8;
      border-color: #1F2937;
    }
  </style>
</head>

<body class="text-theme-fg wrap">
  <div class="content-container container mx-auto p-4 sm:p-6 lg:p-8 min-h-screen">
    <header class="mb-10 premium-banner rounded-2xl p-6 sm:p-12 text-center relative overflow-hidden">
      <div class="absolute top-0 right-0 -mr-16 -mt-16 w-64 h-64 rounded-full bg-white opacity-10"></div>
      <div class="absolute bottom-0 left-0 -ml-20 -mb-20 w-48 h-48 rounded-full bg-white opacity-5"></div>

      <div class="relative z-10">
        <div class="flex justify-center sm:justify-start mb-6">
          <a href="/student/dashboard" class="btn-outline bg-white/10 border-white/20 text-white hover:bg-white hover:text-theme-pt">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
            Dashboard
          </a>
        </div>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-unbounded font-extrabold text-white leading-tight mb-2 tracking-tight">
          Syllabus <span class="text-theme-lt">Tracker</span>
        </h1>
        <p class="text-white/80 font-mono tracking-widest text-xs uppercase mt-4">Chapter-by-chapter progress for your batch</p>
      </div>
    </header>

    <% if (!batchName) { %>
      <div class="stat-card flex flex-col items-center justify-center p-12 text-center">
        <div class="w-16 h-16 rounded-full bg-theme-bg2 border border-theme-bd flex items-center justify-center mb-4 text-theme-fdd">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>
        </div>
        <h3 class="text-xl font-bold font-mono uppercase tracking-wider mb-2">No Batch Assigned</h3>
        <p class="text-sm text-theme-fdd">You'll see syllabus progress here once you're assigned to a batch.</p>
      </div>
    <% } else { %>

      <div class="mb-6 flex gap-4 text-xs font-mono font-bold text-theme-fdd uppercase">
        <div class="flex items-center gap-2"><div class="w-3 h-3 rounded bg-theme-bg2 border border-theme-bd"></div> Not Started</div>
        <div class="flex items-center gap-2"><div class="w-3 h-3 rounded bg-emerald-500"></div> Completed</div>
      </div>

      <div id="subjects-container" class="space-y-6" data-syllabus="<%= JSON.stringify(syllabusMap) %>" data-batch-name="<%= batchName %>"></div>

      <script>
        const container = document.getElementById('subjects-container');
        const batchName = container.dataset.batchName;
        const syllabusMap = JSON.parse(container.dataset.syllabus || "{}");
        const subjects = getSubjectsForBatch(batchName);

        if (subjects.length === 0) {
          container.innerHTML = '<div class="stat-card text-center py-12 text-theme-fdd font-mono text-sm uppercase tracking-widest">No subjects configured for this batch yet.</div>';
        }

        subjects.forEach(subject => {
          const subjectData = syllabusMap[subject] || {};
          const statuses = subjectData.chapterStatuses || {};
          const totalChapters = subjectData.totalChapters || 10;

          let completed = 0;
          let gridHtml = '';
          for (let i = 1; i <= totalChapters; i++) {
            const status = statuses[i.toString()] || 'incomplete';
            if (status === 'completed') completed++;
            const displayContent = status === 'completed' ? `${i} ✓` : i;
            gridHtml += `<div class="chapter-pill status-${status}" title="Chapter ${i}">${displayContent}</div>`;
          }
          const pct = totalChapters > 0 ? Math.round((completed / totalChapters) * 100) : 0;

          const subjectCard = `
            <div class="stat-card">
              <div class="flex justify-between items-center mb-6">
                <h2 class="text-xl font-bold font-mono tracking-tight" style="color: var(--fg);">${subject}</h2>
                <span class="text-xs font-mono font-bold text-theme-pt">${completed}/${totalChapters} • ${pct}%</span>
              </div>
              <div class="flex flex-wrap gap-3">${gridHtml}</div>
            </div>
          `;
          container.insertAdjacentHTML('beforeend', subjectCard);
        });
      </script>
    <% } %>
  </div>
</body>
</html>
