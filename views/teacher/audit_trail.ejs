<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <link rel="icon" href="/favicon.ico" type="image/x-icon">
  <link rel="apple-touch-icon" href="/images/logo.png">
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Audit Trail | Tuition Hub</title>
  <%- include('../partials/background') %>
  <style>
    .dash-greeting {
      font-family: 'Unbounded', sans-serif;
      font-size: clamp(1.8rem, 4vw, 3rem);
      font-weight: 900;
      line-height: 1;
      letter-spacing: -0.03em;
    }
    .dash-sub {
      font-family: 'Space Mono', monospace;
      font-size: 0.65rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--fdd);
      margin-top: 8px;
    }
    .stat-card {
      background: var(--bgc);
      backdrop-filter: blur(16px);
      border: 1px solid var(--bd);
      border-radius: 18px;
      padding: 24px;
      transition: all 0.35s cubic-bezier(.34,1.56,.64,1);
    }
    .badge {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 4px 10px;
      border-radius: 6px;
      font-family: 'Space Mono', monospace;
      font-size: 0.65rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      white-space: nowrap;
    }
    .type-audit { background: var(--pg2); color: var(--pt); border: 1px solid var(--pg); }
    .type-email { background: rgba(124,58,237,0.08); color: var(--pt); border: 1px solid var(--pg); }
    .status-success { background: var(--gg); color: var(--gt); border: 1px solid rgba(52, 211, 153, 0.2); border-radius: 20px; }
    .status-failed { background: var(--rg); color: var(--rt); border: 1px solid rgba(248, 113, 113, 0.2); border-radius: 20px; }
    .status-sent { background: var(--gg); color: var(--gt); border: 1px solid rgba(52, 211, 153, 0.2); border-radius: 20px; }
  </style>
</head>
<body class="text-theme-fg m-0 p-0 overflow-hidden" style="background: var(--bg);">
  <div style="display: flex; height: 100vh; overflow: hidden;">
    <%- include('../partials/teacher_sidebar') %>

    <div style="flex: 1; display: flex; flex-direction: column; overflow: hidden;">
      <main style="flex: 1; overflow-y: auto;">
        <div class="content-container container mx-auto p-4 sm:p-6 lg:p-8 min-h-screen">

          <header class="mb-8 flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
            <div>
              <div class="flex items-center gap-3 mb-2">
                <a href="/teacher/reports" class="text-theme-fdd hover:text-theme-pt transition-colors">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                </a>
                <h1 class="dash-greeting">Audit <span style="color: var(--pt);">Trail</span></h1>
              </div>
              <p class="dash-sub">Every administrative action, payment, and email — one timeline</p>
            </div>

            <form action="/teacher/reports/audit" method="GET" class="flex flex-wrap gap-3">
              <input type="text" name="q" value="<%= queryQ %>" placeholder="Search actor, details, recipient..." class="bg-theme-bgc text-theme-fg border border-theme-b rounded-xl px-4 py-2 text-sm font-semibold focus:outline-none focus:border-theme-p w-64">
              <select name="type" class="bg-theme-bgc text-theme-fg border border-theme-b rounded-xl px-4 py-2 text-sm font-semibold focus:outline-none focus:border-theme-p">
                <option value="">All Types</option>
                <option value="Audit" <%= queryType === 'Audit' ? 'selected' : '' %>>Audit (actions & payments)</option>
                <option value="Email" <%= queryType === 'Email' ? 'selected' : '' %>>Email</option>
              </select>
              <select name="status" class="bg-theme-bgc text-theme-fg border border-theme-b rounded-xl px-4 py-2 text-sm font-semibold focus:outline-none focus:border-theme-p">
                <option value="">All Statuses</option>
                <option value="Success" <%= queryStatus === 'Success' ? 'selected' : '' %>>Success</option>
                <option value="Failed" <%= queryStatus === 'Failed' ? 'selected' : '' %>>Failed</option>
              </select>
              <button type="submit" class="btn-solid-purple px-4 py-2">Filter</button>
              <% if (queryQ || queryType || queryStatus) { %>
                <a href="/teacher/reports/audit" class="px-4 py-2 text-sm font-semibold text-theme-fdd hover:text-theme-fg transition-colors">Clear</a>
              <% } %>
            </form>
          </header>

          <div class="stat-card p-0 overflow-hidden border border-theme-bd">
            <div class="overflow-x-auto">
              <table class="w-full text-left border-collapse">
                <thead>
                  <tr class="bg-theme-bg2 border-b border-theme-bd text-[10px] uppercase font-mono tracking-widest text-theme-fdd">
                    <th class="p-4 font-bold">Date & Time</th>
                    <th class="p-4 font-bold">Type</th>
                    <th class="p-4 font-bold">Actor</th>
                    <th class="p-4 font-bold">Action / Entity</th>
                    <th class="p-4 font-bold">Details</th>
                    <th class="p-4 font-bold text-center">Status</th>
                  </tr>
                </thead>
                <tbody class="text-sm font-semibold divide-y divide-theme-bd">
                  <% if (logs.length === 0) { %>
                    <tr>
                      <td colspan="6" class="p-8 text-center text-theme-fdd">No activity found for this period.</td>
                    </tr>
                  <% } else { %>
                    <% logs.forEach(log => { %>
                      <tr class="hover:bg-theme-bgch transition-colors group">
                        <td class="p-4">
                          <div class="flex flex-col">
                            <span class="text-theme-fg"><%= formatDate(log.date, {day:'numeric', month:'short', year:'numeric'}) %></span>
                            <span class="text-xs text-theme-fdd font-mono"><%= formatTime(log.date) %></span>
                          </div>
                        </td>
                        <td class="p-4">
                          <span class="badge <%= log.type === 'Audit' ? 'type-audit' : 'type-email' %>"><%= log.type %></span>
                        </td>
                        <td class="p-4">
                          <div class="flex flex-col">
                            <span class="text-theme-fg"><%= log.actor %></span>
                            <span class="text-xs text-theme-fdd font-mono"><%= log.actorRole %></span>
                          </div>
                        </td>
                        <td class="p-4">
                          <span class="text-xs px-2 py-1 bg-theme-bg2 border border-theme-bd rounded text-theme-pt font-bold uppercase tracking-wider font-mono">
                            <%= log.label %><% if (log.entity && log.entity !== log.label) { %> · <%= log.entity %><% } %>
                          </span>
                        </td>
                        <td class="p-4 text-theme-fg truncate max-w-[320px]" title="<%= log.note || log.details %>">
                          <%= log.details %>
                        </td>
                        <td class="p-4 text-center">
                          <% const cls = log.status === 'Failed' ? 'status-failed' : (log.status === 'Sent' ? 'status-sent' : 'status-success'); %>
                          <% const icon = log.status === 'Failed' ? '✗' : '✓'; %>
                          <span class="badge <%= cls %>" title="<%= log.note || '' %>">
                            <%= icon %> <%= log.status %>
                          </span>
                        </td>
                      </tr>
                    <% }) %>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </main>
    </div>
  </div>
</body>
</html>
