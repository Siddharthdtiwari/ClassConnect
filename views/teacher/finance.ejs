<!DOCTYPE html>
<html lang="en" data-theme="light">

<head>
  <link rel="icon" href="/favicon.ico" type="image/x-icon">
  <link rel="apple-touch-icon" href="/images/logo.png">
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Finance & Salaries | Tuition Hub</title>
  
  <%- include('../partials/background') %>

  <style>
    /* Custom Design System for Executive Finance Dashboard */
    .dash-greeting {
      font-family: 'Unbounded', sans-serif;
      font-size: clamp(1.8rem, 4vw, 2.8rem);
      font-weight: 900;
      line-height: 1.1;
      letter-spacing: -0.03em;
    }
    .dash-sub {
      font-family: 'Space Mono', monospace;
      font-size: 0.68rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--fdd);
      margin-top: 8px;
    }
    .text-gradient-purple {
      background: linear-gradient(135deg, #7c3aed 0%, #a855f7 100%);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    
    /* Stat Cards */
    .fin-card {
      background: var(--bgc);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid var(--bd);
      border-radius: 20px;
      padding: 24px;
      transition: all 0.3s cubic-bezier(.34,1.56,.64,1);
      position: relative;
      overflow: hidden;
      box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.05);
    }
    .fin-card:hover {
      transform: translateY(-4px);
      border-color: rgba(124, 58, 237, 0.3);
      box-shadow: 0 16px 36px -4px rgba(124, 58, 237, 0.12);
    }
    .fin-card-title {
      font-family: 'Space Mono', monospace;
      font-size: 0.65rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--fdd);
      font-weight: 700;
    }
    .fin-card-value {
      font-family: 'Unbounded', system-ui, -apple-system, sans-serif;
      font-size: 2.1rem;
      font-weight: 900;
      line-height: 1.1;
      margin-top: 8px;
      letter-spacing: -0.02em;
    }

    /* Custom Table (Overriding generic ugly table styles) */
    .fin-table-container {
      background: var(--bgc);
      backdrop-filter: blur(20px);
      border: 1px solid var(--bd);
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.04);
    }
    .fin-table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
    }
    .fin-table th {
      background: rgba(124, 58, 237, 0.06);
      padding: 16px 20px;
      font-family: 'Space Mono', monospace;
      font-size: 0.68rem;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--fg);
      border-bottom: 1px solid var(--bd);
    }
    .fin-table td {
      padding: 16px 20px;
      border-bottom: 1px solid var(--bd);
      font-size: 0.88rem;
      color: var(--fg);
      transition: background 0.2s;
    }
    .fin-table tr:last-child td {
      border-bottom: none;
    }
    .fin-table tbody tr:hover td {
      background: rgba(124, 58, 237, 0.03);
    }

    /* Category Pill Badges */
    .cat-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 10px;
      border-radius: 12px;
      font-size: 0.72rem;
      font-weight: 700;
      font-family: 'Space Mono', monospace;
      text-transform: uppercase;
    }
  </style>
</head>

<body class="text-theme-fg m-0 p-0 overflow-hidden" style="background: var(--bg);">
  <div style="display: flex; height: 100vh; overflow: hidden;">
    <%- include('../partials/teacher_sidebar') %>
    
    <div style="flex: 1; display: flex; flex-direction: column; overflow: hidden; position: relative;">
      <main style="flex: 1; overflow-y: auto; overflow-x: hidden;">
        <div class="content-container container mx-auto p-4 sm:p-6 lg:p-8 min-h-screen">
          
          <!-- Header -->
          <header class="mb-10 flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
            <div>
              <h1 class="dash-greeting">Finance & <span class="text-gradient-purple">Salaries</span></h1>
              <p class="dash-sub">Executive P&L Dashboard · Revenue, Payroll & Net Margin (<%= currentAcademicYear %>)</p>
            </div>
            <div class="flex gap-3 flex-wrap items-center">
              <!-- Month Selector Filter -->
              <form method="GET" action="/teacher/finance" id="month-filter-form">
                <select name="month" onchange="document.getElementById('month-filter-form').submit()" 
                  class="px-4 py-2.5 bg-theme-bgc text-theme-fg border border-theme-b rounded-xl focus:border-theme-p outline-none font-bold text-xs cursor-pointer shadow-sm">
                  <option value="">🗓️ All Months (Annual)</option>
                  <% if (typeof academicMonths !== 'undefined') { %>
                    <% academicMonths.forEach(m => { %>
                      <option value="<%= m %>" <%= typeof selectedMonth !== 'undefined' && selectedMonth === m ? 'selected' : '' %>>📅 <%= m %></option>
                    <% }) %>
                  <% } %>
                </select>
              </form>

              <a href="/teacher/salaries" class="flex items-center gap-2 px-4 py-2.5 bg-theme-bgc border border-theme-b rounded-xl text-sm font-bold hover:border-purple-400 transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/></svg>
                Salary Sheet
              </a>
              <button onclick="openModal('add-transaction-modal')" class="btn-solid-purple flex items-center gap-2 shadow-lg hover:scale-105 transition-transform">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path d="M12 4v16m8-8H4"/></svg>
                Add Transaction
              </button>
            </div>
          </header>

          <!-- Toast Notifications -->
          <% if (typeof success !== 'undefined' && success) { %>
          <div id="toast-success" class="mb-6 flex items-center gap-3 bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 rounded-2xl px-5 py-3.5 shadow-md text-xs font-bold">
            <span class="text-base">✓</span> <%= success %>
          </div>
          <% } %>
          <% if (typeof error !== 'undefined' && error) { %>
          <div id="toast-error" class="mb-6 flex items-center gap-3 bg-rose-500/10 border border-rose-500/20 text-rose-600 dark:text-rose-400 rounded-2xl px-5 py-3.5 shadow-md text-xs font-bold">
            <span class="text-base">✗</span> <%= error %>
          </div>
          <% } %>

          <!-- Metrics Row -->
          <div class="mb-3 flex justify-between items-center">
            <span class="text-xs font-mono uppercase tracking-widest text-theme-fdd font-bold">
              📊 <%= selectedMonth ? selectedMonth + ' Summary' : 'Full Academic Year Overview' %>
            </span>
            <% if (selectedMonth) { %>
              <a href="/teacher/finance" class="text-xs font-mono font-bold text-purple-600 hover:underline">Reset to Full Year</a>
            <% } %>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-10">
            <!-- Total Revenue Card -->
            <div class="fin-card">
              <div class="flex justify-between items-center mb-2">
                <span class="fin-card-title">Total Revenue</span>
                <span class="p-2 rounded-xl bg-emerald-500/10 text-emerald-600">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                </span>
              </div>
              <div class="fin-card-value text-emerald-600 dark:text-emerald-400">₹<%= totalIncome.toLocaleString('en-IN') %></div>
              <div class="text-[11px] font-medium text-theme-fdd mt-2 flex items-center justify-between">
                <span>Fees: ₹<%= studentFeeRevenue.toLocaleString('en-IN') %></span>
                <span>Manual: ₹<%= manualIncome.toLocaleString('en-IN') %></span>
              </div>
            </div>

            <!-- Total Expenses Card -->
            <div class="fin-card">
              <div class="flex justify-between items-center mb-2">
                <span class="fin-card-title">Total Expenses</span>
                <span class="p-2 rounded-xl bg-rose-500/10 text-rose-600">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
                </span>
              </div>
              <div class="fin-card-value text-rose-600 dark:text-rose-400">₹<%= totalExpense.toLocaleString('en-IN') %></div>
              <div class="text-[11px] font-medium text-theme-fdd mt-2">Salaries, Rent & Operations</div>
            </div>

            <!-- Net Profit / Loss Card -->
            <div class="fin-card">
              <div class="flex justify-between items-center mb-2">
                <span class="fin-card-title">Net Profit / Loss</span>
                <span class="p-2 rounded-xl <%= grossProfit >= 0 ? 'bg-purple-500/10 text-purple-600' : 'bg-rose-500/10 text-rose-600' %>">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 12V7H5a2 2 0 0 1 0-4h14v4"/><path d="M3 5v14a2 2 0 0 0 2 2h16v-5"/><path d="M18 12a2 2 0 0 0 0 4h4v-4Z"/></svg>
                </span>
              </div>
              <div class="fin-card-value <%= grossProfit >= 0 ? 'text-purple-600 dark:text-purple-400' : 'text-rose-600 dark:text-rose-400' %>">
                <%= grossProfit >= 0 ? '+' : '' %>₹<%= grossProfit.toLocaleString('en-IN') %>
              </div>
              <div class="text-[11px] font-medium text-theme-fdd mt-2">
                <%= grossProfit >= 0 ? '🎉 Positive Net Surplus' : '⚠️ Net Deficit' %>
              </div>
            </div>

            <!-- Student Fees Paid Card -->
            <div class="fin-card">
              <div class="flex justify-between items-center mb-2">
                <span class="fin-card-title">Fees Collected</span>
                <span class="p-2 rounded-xl bg-sky-500/10 text-sky-600">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
                </span>
              </div>
              <div class="fin-card-value text-sky-600 dark:text-sky-400">₹<%= studentFeeRevenue.toLocaleString('en-IN') %></div>
              <div class="text-[11px] font-medium text-theme-fdd mt-2">Direct Fee Receipts</div>
            </div>
          </div>

          <!-- SECTION 1: Monthly Financial Performance Table -->
          <div class="fin-table-container mb-12">
            <div class="p-6 border-b border-theme-b flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 bg-purple-500/5">
              <div>
                <h2 class="text-base font-extrabold text-theme-fg flex items-center gap-2" style="font-family: 'Unbounded', sans-serif;">
                  <span>🗓️</span> Monthly Financial Performance
                </h2>
                <p class="dash-sub">12-Month Academic Breakdown & Net Profit Tracker</p>
              </div>
            </div>

            <div class="overflow-x-auto">
              <table class="fin-table">
                <thead>
                  <tr>
                    <th>Month</th>
                    <th class="text-right">Student Fees</th>
                    <th class="text-right">Other Income</th>
                    <th class="text-right">Total Revenue</th>
                    <th class="text-right">Expenses</th>
                    <th class="text-right">Net Profit / Loss</th>
                    <th class="text-center w-28">Action</th>
                  </tr>
                </thead>
                <tbody>
                  <% 
                    let totFees = 0, totOther = 0, totInc = 0, totExp = 0, totNet = 0;
                    if (typeof monthlyBreakdown !== 'undefined' && monthlyBreakdown.length > 0) {
                      monthlyBreakdown.forEach(m => {
                        totFees += m.feeRevenue;
                        totOther += m.manualIncome;
                        totInc += m.totalIncome;
                        totExp += m.totalExpense;
                        totNet += m.netProfit;
                        const isSelected = selectedMonth === m.month;
                  %>
                  <tr class="<%= isSelected ? 'bg-purple-500/10 font-bold' : '' %>">
                    <td class="font-bold text-sm text-theme-fg">
                      <div class="flex items-center gap-2">
                        <span><%= m.month %></span>
                        <% if (isSelected) { %>
                          <span class="px-2 py-0.5 rounded-full text-[9px] font-mono font-extrabold bg-purple-600 text-white">ACTIVE</span>
                        <% } %>
                      </div>
                    </td>
                    <td class="text-right font-semibold text-sm">₹<%= m.feeRevenue.toLocaleString('en-IN') %></td>
                    <td class="text-right font-semibold text-sm text-theme-fdd">₹<%= m.manualIncome.toLocaleString('en-IN') %></td>
                    <td class="text-right font-extrabold text-sm text-emerald-600 dark:text-emerald-400">₹<%= m.totalIncome.toLocaleString('en-IN') %></td>
                    <td class="text-right font-extrabold text-sm text-rose-600 dark:text-rose-400">₹<%= m.totalExpense.toLocaleString('en-IN') %></td>
                    <td class="text-right">
                      <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-black <%= m.netProfit >= 0 ? 'bg-emerald-500/10 text-emerald-600 border border-emerald-500/20' : 'bg-rose-500/10 text-rose-600 border border-rose-500/20' %>">
                        <%= m.netProfit >= 0 ? '↑ +' : '↓ ' %>₹<%= m.netProfit.toLocaleString('en-IN') %>
                      </span>
                    </td>
                    <td class="text-center">
                      <a href="/teacher/finance<%= isSelected ? '' : '?month=' + m.month %>" 
                        class="px-3 py-1.5 rounded-xl font-bold text-xs transition-all inline-block <%= isSelected ? 'bg-purple-600 text-white shadow-md' : 'bg-purple-500/10 text-purple-600 hover:bg-purple-600 hover:text-white' %>">
                        <%= isSelected ? 'Show All' : 'Filter' %>
                      </a>
                    </td>
                  </tr>
                  <%   }); 
                    } 
                  %>
                </tbody>
                <tfoot>
                  <tr class="bg-purple-500/10 font-bold border-t-2 border-purple-500/30">
                    <td class="font-extrabold text-sm uppercase tracking-wider text-theme-fg" style="font-family: 'Unbounded', sans-serif;">Annual Total</td>
                    <td class="text-right font-extrabold text-sm">₹<%= totFees.toLocaleString('en-IN') %></td>
                    <td class="text-right font-extrabold text-sm text-theme-fdd">₹<%= totOther.toLocaleString('en-IN') %></td>
                    <td class="text-right font-black text-base text-emerald-600 dark:text-emerald-400">₹<%= totInc.toLocaleString('en-IN') %></td>
                    <td class="text-right font-black text-base text-rose-600 dark:text-rose-400">₹<%= totExp.toLocaleString('en-IN') %></td>
                    <td class="text-right">
                      <span class="inline-flex items-center gap-1 px-3.5 py-1.5 rounded-full text-xs font-black <%= totNet >= 0 ? 'bg-emerald-500/20 text-emerald-600 border border-emerald-500/30' : 'bg-rose-500/20 text-rose-600 border border-rose-500/30' %>">
                        <%= totNet >= 0 ? '↑ +' : '↓ ' %>₹<%= totNet.toLocaleString('en-IN') %>
                      </span>
                    </td>
                    <td class="text-center">
                      <% if (selectedMonth) { %>
                        <a href="/teacher/finance" class="text-xs font-mono font-bold text-purple-600 underline">Reset</a>
                      <% } %>
                    </td>
                  </tr>
                </tfoot>
              </table>
            </div>
          </div>

          <!-- SECTION 2: Transaction Ledger -->
          <div class="fin-table-container mb-10">
            <div class="p-6 border-b border-theme-b flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 bg-purple-500/5">
              <div>
                <h2 class="text-base font-extrabold text-theme-fg flex items-center gap-2" style="font-family: 'Unbounded', sans-serif;">
                  <span>🧾</span> Transaction Ledger
                </h2>
                <p class="dash-sub"><%= selectedMonth ? 'Entries for ' + selectedMonth : 'All manual income & expense entries' %></p>
              </div>
              <div class="relative w-full sm:w-72">
                <input type="text" id="transaction-search" placeholder="Search category or description..." 
                  class="w-full pl-10 pr-4 py-2 bg-theme-bgc text-theme-fg border border-theme-b rounded-xl focus:border-theme-p focus:outline-none font-semibold text-xs shadow-sm">
                <svg class="w-4 h-4 text-theme-fdd absolute left-3.5 top-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
              </div>
            </div>

            <% if (!transactions || transactions.length === 0) { %>
            <div class="p-12 text-center text-theme-fdd">
              <p class="text-4xl mb-3">💸</p>
              <p class="font-bold text-base text-theme-fg">No Transactions Recorded</p>
              <p class="text-xs mt-1 text-theme-fdd"><%= selectedMonth ? 'No entries found for ' + selectedMonth + '.' : 'Click "+ Add Transaction" to record staff salaries, rent, or expenses.' %></p>
            </div>
            <% } else { %>
            <div class="overflow-x-auto">
              <table class="fin-table">
                <thead>
                  <tr>
                    <th>Date</th>
                    <th>Type</th>
                    <th>Category</th>
                    <th>Description / Details</th>
                    <th class="text-right">Amount</th>
                    <th class="text-center w-20">Action</th>
                  </tr>
                </thead>
                <tbody>
                  <% transactions.forEach(t => { 
                    const formattedDate = new Date(t.date).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
                    const isIncome = t.type === 'INCOME';
                    const catIcons = { 'Salary':'👨‍🏫','Rent':'🏢','Utilities':'⚡','Marketing':'📢','Software/IT':'💻','Supplies':'✏️','Other':'📦' };
                    const icon = catIcons[t.category] || '💸';
                  %>
                  <tr class="transaction-row">
                    <td class="font-bold text-xs text-purple-600 dark:text-purple-400 font-mono"><%= formattedDate %></td>
                    <td>
                      <span class="cat-badge <%= isIncome ? 'bg-emerald-500/10 text-emerald-600 border border-emerald-500/20' : 'bg-rose-500/10 text-rose-600 border border-rose-500/20' %>">
                        <%= isIncome ? '↑ INCOME' : '↓ EXPENSE' %>
                      </span>
                    </td>
                    <td class="font-extrabold text-sm text-theme-fg search-category">
                      <span class="mr-1.5"><%= icon %></span><%= t.category %>
                    </td>
                    <td class="text-theme-fdd text-xs font-semibold search-desc"><%= t.description || '—' %></td>
                    <td class="text-right font-black text-sm <%= isIncome ? 'text-emerald-600 dark:text-emerald-400' : 'text-rose-600 dark:text-rose-400' %>">
                      <%= isIncome ? '+' : '-' %>₹<%= t.amount.toLocaleString('en-IN') %>
                    </td>
                    <td class="text-center">
                      <form method="POST" action="/teacher/finance/delete/<%= t._id %>" onsubmit="return confirm('Delete this transaction entry?')">
                        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                        <button type="submit" class="p-1.5 rounded-lg text-rose-500 hover:bg-rose-500/10 transition-colors" title="Delete Transaction">
                          <svg class="w-4 h-4 mx-auto" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                        </button>
                      </form>
                    </td>
                  </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
            <div id="no-results-msg" class="hidden p-6 text-center text-theme-fdd bg-theme-bgc/20 border-t border-theme-b italic text-xs font-semibold">No transactions match your search.</div>
            <% } %>

          </div>

        </div>
      </main>
    </div>
  </div>

  <!-- =================== ADD TRANSACTION MODAL =================== -->
  <div class="modal-overlay" id="add-transaction-modal">
    <div class="modal-box">
      <!-- Gradient Header -->
      <div class="modal-header">
        <div class="flex justify-between items-start">
          <div>
            <div class="flex items-center gap-2 mb-1">
              <span class="text-2xl">💳</span>
              <h2 class="text-xl font-extrabold tracking-tight">Add Transaction</h2>
            </div>
            <p class="text-purple-200 text-xs font-semibold">Record expenses or manual income for accounting</p>
          </div>
          <button onclick="closeModal('add-transaction-modal')" class="text-white/60 hover:text-white text-3xl font-light leading-none">&times;</button>
        </div>
      </div>

      <!-- Body -->
      <div class="modal-body">
        <form method="POST" action="/teacher/finance/add" class="space-y-4">
          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
          
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-[10px] font-bold text-theme-fdd uppercase tracking-widest mb-1.5 font-mono">Transaction Type</label>
              <select name="type" required class="w-full px-4 py-2.5 bg-theme-bgc text-theme-fg border border-theme-b rounded-xl focus:border-theme-p outline-none font-semibold text-xs cursor-pointer">
                <option value="EXPENSE">Expense</option>
                <option value="INCOME">Income (Manual)</option>
              </select>
            </div>
            <div>
              <label class="block text-[10px] font-bold text-theme-fdd uppercase tracking-widest mb-1.5 font-mono">Amount (₹)</label>
              <input type="number" name="amount" min="1" required placeholder="5000" class="w-full px-4 py-2.5 bg-theme-bgc text-theme-fg border border-theme-b rounded-xl focus:border-theme-p outline-none font-semibold text-xs" />
            </div>
          </div>

          <div>
            <label class="block text-[10px] font-bold text-theme-fdd uppercase tracking-widest mb-1.5 font-mono">Category</label>
            <select name="category" id="transaction-category" required onchange="handleCategoryChange(this)" class="w-full px-4 py-2.5 bg-theme-bgc text-theme-fg border border-theme-b rounded-xl focus:border-theme-p outline-none font-semibold text-xs cursor-pointer">
              <option value="Salary" selected>👨‍🏫 Teacher / Staff Salary</option>
              <option value="Rent">🏢 Premises Rent</option>
              <option value="Utilities">⚡ Electricity & Internet</option>
              <option value="Marketing">📢 Marketing & Banners</option>
              <option value="Software/IT">💻 Software & Cloud Subscriptions</option>
              <option value="Supplies">✏️ Print & Stationery</option>
              <option value="Other">📦 Other Expenses</option>
            </select>
          </div>

          <div id="staff-select-container">
            <label class="block text-[10px] font-bold text-theme-fdd uppercase tracking-widest mb-1.5 font-mono">Select Staff / Teacher</label>
            <select name="staffName" id="staffName-select" class="w-full px-4 py-2.5 bg-theme-bgc text-theme-fg border border-theme-b rounded-xl focus:border-theme-p outline-none font-semibold text-xs cursor-pointer">
              <option value="">Select Staff Member...</option>
              <% if (typeof teachers !== 'undefined' && teachers.length > 0) { %>
                <% teachers.forEach(t => { %>
                  <option value="<%= t.teacherName %>"><%= t.teacherName %> (<%= t.role.toUpperCase() %>)</option>
                <% }) %>
              <% } %>
            </select>
          </div>

          <div id="salary-month-container">
            <label class="block text-[10px] font-bold text-theme-fdd uppercase tracking-widest mb-1.5 font-mono">Salary For Month</label>
            <select name="salaryMonth" id="salary-month-select" class="w-full px-4 py-2.5 bg-theme-bgc text-theme-fg border border-theme-b rounded-xl focus:border-theme-p outline-none font-semibold text-xs cursor-pointer">
              <option value="">Select Month...</option>
              <% if (typeof academicMonths !== 'undefined') { %>
                <% academicMonths.forEach(m => { %>
                  <option value="<%= m %>"><%= m %></option>
                <% }) %>
              <% } %>
            </select>
          </div>

          <div>
            <label class="block text-[10px] font-bold text-theme-fdd uppercase tracking-widest mb-1.5 font-mono">Transaction Date</label>
            <input type="date" name="date" required value="<%= new Date().toISOString().split('T')[0] %>" class="w-full px-4 py-2.5 bg-theme-bgc text-theme-fg border border-theme-b rounded-xl focus:border-theme-p outline-none font-semibold text-xs font-mono" />
          </div>

          <div>
            <label class="block text-[10px] font-bold text-theme-fdd uppercase tracking-widest mb-1.5 font-mono">Description / Notes</label>
            <input type="text" name="description" placeholder="e.g., June Salary for Mr. Sharma" class="w-full px-4 py-2.5 bg-theme-bgc text-theme-fg border border-theme-b rounded-xl focus:border-theme-p outline-none font-semibold text-xs" />
          </div>

          <button type="submit" class="btn-primary w-full py-3.5 text-sm mt-4 shadow-xl">Save Transaction ✓</button>
        </form>
      </div>
    </div>
  </div>

  <script>
    function openModal(id) { document.getElementById(id).classList.add('open'); }
    function closeModal(id) { document.getElementById(id).classList.remove('open'); }
    
    document.querySelectorAll('.modal-overlay').forEach(o => o.addEventListener('click', function(e){ if(e.target===this) closeModal(this.id); }));

    function handleCategoryChange(sel) {
      const staffContainer = document.getElementById('staff-select-container');
      if (sel.value === 'Salary') {
        staffContainer.classList.remove('hidden');
      } else {
        staffContainer.classList.add('hidden');
        document.getElementById('staffName-select').value = '';
      }
    }

    // Search filter
    const searchInput = document.getElementById('transaction-search');
    if (searchInput) {
      searchInput.addEventListener('input', () => {
        const q = searchInput.value.toLowerCase();
        let any = false;
        document.querySelectorAll('.transaction-row').forEach(row => {
          const cat = row.querySelector('.search-category')?.textContent.toLowerCase() || '';
          const desc = row.querySelector('.search-desc')?.textContent.toLowerCase() || '';
          const match = cat.includes(q) || desc.includes(q);
          row.style.display = match ? '' : 'none';
          if (match) any = true;
        });
        const noRes = document.getElementById('no-results-msg');
        if (noRes) noRes.classList.toggle('hidden', any || !q);
      });
    }

    // Auto-dismiss toasts
    setTimeout(() => {
      ['toast-success','toast-error'].forEach(id => { 
        const el = document.getElementById(id); 
        if(el) { 
          el.style.opacity = '0'; 
          setTimeout(() => { if(el) el.style.display = 'none'; }, 300); 
        } 
      });
    }, 4000);
  </script>
</body>

</html>
