<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <link rel="icon" href="/favicon.ico" type="image/x-icon">
  <link rel="apple-touch-icon" href="/images/logo.png">
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Syllabus Tracker | Tuition Hub</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@400;600;900&family=Space+Mono:ital,wght@0,400;0,700;1,400&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <script src="/js/subjects.js"></script>
  <%- include('../partials/background') %>
  
  <style>
    .dash-greeting {
      font-family: 'Unbounded', sans-serif;
      font-size: clamp(1.8rem, 4vw, 3rem);
      font-weight: 900;
      line-height: 1;
      letter-spacing: -0.03em;
    }
    .dash-sub {
      font-family: 'Space Mono', monospace;
      font-size: 0.65rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--fdd);
      margin-top: 8px;
    }
    .stat-card {
      background: var(--bgc);
      backdrop-filter: blur(16px);
      border: 1px solid var(--bd);
      border-radius: 18px;
      padding: 24px;
      transition: all 0.35s cubic-bezier(.34,1.56,.64,1);
      position: relative;
    }
    
    /* Chapter Pill Styles */
    .chapter-pill {
      width: 48px;
      height: 48px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Space Mono', monospace;
      font-weight: bold;
      font-size: 14px;
      cursor: pointer;
      user-select: none;
      transition: all 0.2s ease;
      border: 2px solid transparent;
    }
    
    /* Statuses */
    .status-incomplete {
      background-color: var(--bg2);
      color: var(--fdd);
      border-color: var(--bd);
    }
    
    .status-completed {
      background-color: #10B981; /* Emerald 500 */
      color: white;
      box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
      border-color: #059669; /* Emerald 600 */
    }
    
    .status-na {
      background-color: #374151; /* Gray 700 */
      color: #9CA3AF; /* Gray 400 */
      text-decoration: line-through;
      opacity: 0.8;
      border-color: #1F2937; /* Gray 800 */
    }

    .chapter-pill:hover {
      transform: scale(1.05);
    }
    
    .chapter-pill:active {
      transform: scale(0.95);
    }

    .chapter-pill-sm {
      width: 32px;
      height: 32px;
      font-size: 11px;
      cursor: default;
    }
    .chapter-pill-sm:hover { transform: none; }

    .student-progress-toggle {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 10px 0;
      border-top: 1px solid var(--bd);
      background: none;
      border-left: none;
      border-right: none;
      border-bottom: none;
      cursor: pointer;
    }
    .student-progress-list {
      display: flex;
      flex-direction: column;
      gap: 10px;
      padding-top: 10px;
    }
    .student-progress-row {
      border-bottom: 1px solid var(--bd);
      padding-bottom: 8px;
    }
    .student-progress-summary {
      display: flex;
      align-items: center;
      gap: 12px;
      cursor: pointer;
      padding: 4px 0;
    }
    .student-progress-name {
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--fg);
      width: 160px;
      flex-shrink: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .student-progress-bar-track {
      flex: 1;
      height: 8px;
      border-radius: 4px;
      background: var(--bg2);
      overflow: hidden;
      display: block;
    }
    .student-progress-bar-fill {
      display: block;
      height: 100%;
      background: #10B981;
      border-radius: 4px;
      transition: width 0.3s ease;
    }
    .student-progress-pct {
      font-family: 'Space Mono', monospace;
      font-size: 0.7rem;
      font-weight: 700;
      color: var(--fdd);
      width: 90px;
      text-align: right;
      flex-shrink: 0;
    }
  </style>
</head>

<body class="text-theme-fg m-0 p-0 overflow-hidden" style="background: var(--bg);">
  <div style="display: flex; height: 100vh; overflow: hidden;">
    <%- include('../partials/teacher_sidebar') %>
    
    <div style="flex: 1; display: flex; flex-direction: column; overflow: hidden; position: relative;">
      <main style="flex: 1; overflow-y: auto; overflow-x: hidden;">
        <div class="content-container container mx-auto p-4 sm:p-6 lg:p-8 min-h-screen">
          
          <header class="mb-10 flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
            <div>
              <h1 class="dash-greeting">Syllabus <span style="color: var(--pt);">Tracker</span></h1>
              <p class="dash-sub">Master Chapter Completion</p>
            </div>
            
            <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 bg-theme-bgc p-4 rounded-2xl border border-theme-bd shadow-sm flex-1">
              <div class="flex flex-col sm:flex-row sm:items-center gap-2 flex-1">
                <span class="text-xs font-mono font-bold uppercase text-theme-fdd px-2">Select Batch:</span>
                <select class="px-4 py-3 rounded-xl text-sm font-bold font-mono bg-theme-bg2 text-theme-fg border border-theme-bd outline-none cursor-pointer w-full" onchange="window.location.href='?batchId=' + this.value">
                  <option value="all" <%= selectedBatchId === 'all' ? 'selected' : '' %>>All Batches</option>
                  <% batches.forEach(batch => { %>
                    <option value="<%= batch._id %>" <%= selectedBatchId === batch._id.toString() ? 'selected' : '' %>><%= batch.name %></option>
                  <% }) %>
                </select>
              </div>
              
              <div class="flex flex-col sm:flex-row sm:items-center gap-2 flex-1">
                <span class="text-xs font-mono font-bold uppercase text-theme-fdd px-2">Select Subject:</span>
                <select id="subjectFilter" class="px-4 py-3 rounded-xl text-sm font-bold font-mono bg-theme-bg2 text-theme-fg border border-theme-bd outline-none cursor-pointer w-full" onchange="filterSubjects(this.value)">
                  <option value="all">All Subjects</option>
                </select>
              </div>
            </div>
          </header>

          <% if (batches.length === 0) { %>
            <div class="stat-card flex flex-col items-center justify-center p-12 text-center">
              <div class="w-16 h-16 rounded-full bg-theme-bg2 border border-theme-bd flex items-center justify-center mb-4 text-theme-fdd">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>
              </div>
              <h3 class="text-xl font-bold font-mono uppercase tracking-wider mb-2">No Active Batches</h3>
              <p class="text-sm text-theme-fdd">Create a batch first to start tracking syllabus.</p>
            </div>
          <% } else if (selectedBatchId) { %>
            
            <div class="mb-6 flex gap-4 text-xs font-mono font-bold text-theme-fdd uppercase">
              <div class="flex items-center gap-2"><div class="w-3 h-3 rounded bg-theme-bg2 border border-theme-bd"></div> Incomplete (Default)</div>
              <div class="flex items-center gap-2"><div class="w-3 h-3 rounded bg-emerald-500"></div> Completed (Double Click)</div>
            </div>

            <!-- Subject Container: Will be populated by JS -->
            <div id="subjects-container" class="space-y-10" data-syllabus="<%= JSON.stringify(syllabusMap) %>" data-student-progress="<%= JSON.stringify(studentProgressMap) %>" data-batch-name="<%= selectedBatchName %>" data-batch-id="<%= selectedBatchId %>" data-batches="<%= JSON.stringify(batches.map(b => ({ id: b._id, name: b.name }))) %>"></div>

            <script>
              const container = document.getElementById('subjects-container');
              const selectedBatchName = container.dataset.batchName;
              const selectedBatchId = container.dataset.batchId;
              const batchesList = JSON.parse(container.dataset.batches || "[]");

              const syllabusMap = JSON.parse(container.dataset.syllabus || "{}");
              const studentProgressMap = JSON.parse(container.dataset.studentProgress || "{}");
              
              let batchesToRender = selectedBatchId === 'all' 
                ? batchesList 
                : [{ id: selectedBatchId, name: selectedBatchName }];

              let allSubjectsSet = new Set();
              
              function getBaseSubject(subject) {
                if (subject.startsWith('Maths')) return 'Maths';
                if (subject.startsWith('Science')) return 'Science';
                if (subject.startsWith('Environmental Studies')) return 'Environmental Studies';
                if (['History', 'Geography', 'Civics', 'Political Science', 'Social Science'].includes(subject)) return 'Social Science';
                return subject;
              }
              
              batchesToRender.forEach(batch => {
                const subjects = getSubjectsForBatch(batch.name);
                
                let batchContainerHtml = `<div class="batch-section w-full" id="batch-section-${batch.id}">`;
                batchContainerHtml += `<div class="grid grid-cols-1 gap-6" id="batch-subjects-${batch.id}">`;
                
                let subjectCardsHtml = '';
                subjects.forEach(subject => {
                  allSubjectsSet.add(getBaseSubject(subject));
                  const batchSyllabus = syllabusMap[batch.id] || {};
                  const subjectData = batchSyllabus[subject] || {};
                  const statuses = subjectData.chapterStatuses || {};
                  const totalChapters = subjectData.totalChapters || 10;
                  
                  let gridHtml = '';
                  for (let i = 1; i <= totalChapters; i++) {
                    const status = statuses[i.toString()] || 'incomplete';
                    
                    let displayContent = i;
                    if (status === 'completed') displayContent = `${i} ✓`;
                    
                    gridHtml += `
                      <div 
                        class="chapter-pill status-${status}" 
                        data-batch="${batch.id}"
                        data-subject="${subject}" 
                        data-chapter="${i}" 
                        data-status="${status}"
                        ondblclick="toggleStatus(this)"
                        title="Chapter ${i}"
                      >
                        ${displayContent}
                      </div>
                    `;
                  }

                  // Per-student breakdown: who's actually revised what, not just what's been taught.
                  const studentRows = (studentProgressMap[batch.id] && studentProgressMap[batch.id][subject]) || [];
                  const cardId = `progress-${batch.id}-${subject.replace(/\s+/g, '_')}`;

                  let studentRowsHtml = '';
                  studentRows.forEach(s => {
                    const pct = s.total > 0 ? Math.round((s.completed / s.total) * 100) : 0;
                    const rowId = `${cardId}-${s.studentId}`;
                    let chapterGridHtml = '';
                    for (let i = 1; i <= totalChapters; i++) {
                      const st = (s.chapterStatuses && s.chapterStatuses[i.toString()]) || 'incomplete';
                      chapterGridHtml += `<div class="chapter-pill chapter-pill-sm status-${st}" title="Chapter ${i}">${st === 'completed' ? i + ' ✓' : i}</div>`;
                    }
                    studentRowsHtml += `
                      <div class="student-progress-row">
                        <div class="student-progress-summary" onclick="toggleStudentChapters('${rowId}')">
                          <span class="student-progress-name">${s.studentName}</span>
                          <span class="student-progress-bar-track">
                            <span class="student-progress-bar-fill" style="width:${pct}%"></span>
                          </span>
                          <span class="student-progress-pct">${s.completed}/${s.total} (${pct}%)</span>
                        </div>
                        <div class="student-progress-chapters hidden" id="${rowId}">
                          <div class="flex flex-wrap gap-2 mt-2">${chapterGridHtml}</div>
                        </div>
                      </div>
                    `;
                  });

                  subjectCardsHtml += `
                    <div class="stat-card subject-card" data-subject="${subject}">
                      <div class="flex justify-between items-center mb-6">
                        <h2 class="text-xl font-bold font-mono tracking-tight" style="color: var(--fg);">${batch.name} - ${subject}</h2>
                        <div class="flex items-center gap-2">
                          <button onclick="updateChapterCount(this, '${batch.id}', '${subject}', 'remove')" class="w-8 h-8 rounded-full bg-theme-bg2 border border-theme-bd flex items-center justify-center text-theme-fg hover:bg-red-500 hover:text-white transition-colors disabled:opacity-50" ${totalChapters <= 1 ? 'disabled' : ''}>
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"></path></svg>
                          </button>
                          <button onclick="updateChapterCount(this, '${batch.id}', '${subject}', 'add')" class="w-8 h-8 rounded-full bg-theme-bg2 border border-theme-bd flex items-center justify-center text-theme-fg hover:bg-emerald-500 hover:text-white transition-colors">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                          </button>
                        </div>
                      </div>
                      <div class="text-[10px] font-mono font-bold uppercase tracking-widest text-theme-fdd mb-2">Taught in Class</div>
                      <div class="flex flex-wrap gap-3 mb-6">
                        ${gridHtml}
                      </div>
                      <button class="student-progress-toggle" onclick="toggleStudentProgress('${cardId}')">
                        <span class="text-[10px] font-mono font-bold uppercase tracking-widest text-theme-fdd">Student Progress (${studentRows.length})</span>
                        <svg class="w-4 h-4 text-theme-fdd" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                      </button>
                      <div class="student-progress-list hidden" id="${cardId}">
                        ${studentRowsHtml || '<div class="text-xs text-theme-fdd py-2">No students found for this batch.</div>'}
                      </div>
                    </div>
                  `;
                });
                
                batchContainerHtml += subjectCardsHtml + `</div></div>`;
                container.insertAdjacentHTML('beforeend', batchContainerHtml);
              });

              // Populate subject dropdown
              const subjectFilter = document.getElementById('subjectFilter');
              if (subjectFilter) {
                Array.from(allSubjectsSet).sort().forEach(subj => {
                  subjectFilter.insertAdjacentHTML('beforeend', `<option value="${subj}">${subj}</option>`);
                });
              }

              function filterSubjects(baseSubject) {
                document.querySelectorAll('.batch-section').forEach(batchSection => {
                  let hasVisible = false;
                  batchSection.querySelectorAll('.subject-card').forEach(card => {
                    if (baseSubject === 'all' || getBaseSubject(card.dataset.subject) === baseSubject) {
                      card.style.display = 'block';
                      hasVisible = true;
                    } else {
                      card.style.display = 'none';
                    }
                  });
                  batchSection.style.display = hasVisible ? 'block' : 'none';
                });
              }

              function updateChapterCount(btn, batchId, subject, action) {
                if (btn.disabled) return;
                btn.disabled = true;
                btn.style.opacity = '0.5';
                fetch('/api/syllabus/update_count', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ batchId: batchId, subject: subject, action: action })
                })
                .then(res => res.json())
                .then(data => {
                  if (data.success) {
                    window.location.reload();
                  } else {
                    alert('Error updating chapters.');
                    btn.disabled = false;
                    btn.style.opacity = '';
                  }
                })
                .catch(err => {
                  console.error('Error updating count:', err);
                  btn.disabled = false;
                  btn.style.opacity = '';
                });
              }

              function toggleStudentProgress(cardId) {
                document.getElementById(cardId).classList.toggle('hidden');
              }

              function toggleStudentChapters(rowId) {
                document.getElementById(rowId).classList.toggle('hidden');
              }

              // Status Toggle Logic
              function toggleStatus(element) {
                const batchId = element.dataset.batch;
                const subject = element.dataset.subject;
                const chapterNo = element.dataset.chapter;
                let currentStatus = element.dataset.status;
                
                // Cycle: incomplete -> completed -> incomplete
                let newStatus = 'incomplete';
                let displayContent = chapterNo;

                if (currentStatus === 'incomplete') {
                  newStatus = 'completed';
                  displayContent = `${chapterNo} ✓`;
                }

                // Optimistic UI Update
                element.className = `chapter-pill status-${newStatus}`;
                element.dataset.status = newStatus;
                element.innerHTML = displayContent;
                
                // Add a small bounce animation effect
                element.style.transform = 'scale(1.15)';
                setTimeout(() => { element.style.transform = ''; }, 150);

                // Save to Backend
                fetch('/api/syllabus/update', {
                  method: 'POST',
                  headers: {
                    'Content-Type': 'application/json'
                  },
                  body: JSON.stringify({
                    batchId: batchId,
                    subject: subject,
                    chapterNo: chapterNo,
                    status: newStatus
                  })
                })
                .then(res => res.json())
                .then(data => {
                  if (!data.success) {
                    console.error('Failed to update status', data.message);
                  }
                })
                .catch(err => console.error('Error saving status:', err));
              }
            </script>
          <% } %>
          
        </div>
      </main>
    </div>
  </div>
</body>
</html>
